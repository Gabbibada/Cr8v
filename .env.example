# Copy to .env.local. Local values come from `npx supabase status`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Optional: AI features report themselves unavailable without it.
ANTHROPIC_API_KEY=

# Set to true once Google OAuth is configured in supabase/config.toml.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Local-only test account used for manual and end-to-end checks against the local database.
E2E_TEST_EMAIL=test.customer@example.com
E2E_TEST_PASSWORD=localtest2026
